# 둘 중 하나 이상 (둘 다 넣으면 하나 막혀도 자동 전환)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 선택 (없으면 해당 기능만 건너뜀)
PEXELS_API_KEY=        # 무료: https://www.pexels.com/api/  → 스톡 영상/사진
PIXABAY_API_KEY=       # 무료: https://pixabay.com/api/docs/
YOUTUBE_API_KEY=       # 무료 할당량: Google Cloud Console → YouTube Data API v3
X_BEARER_TOKEN=        # X API Basic 이상 (유료) — X 중복 검사용
